<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Practice"
    sling:resourceType="cq/gui/components/authoring/dialog"
    extraClientlibs="[aemgeeks.components.author.editor]">
    <content
        granite:class="cmp-author_editor"
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
        <items jcr:primaryType="nt:unstructured">
            <column
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/container">
                <items jcr:primaryType="nt:unstructured">
                    <path
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                        fieldLabel="Image path"
                        name="./path"
                        rootPath="/content/dam/my-project"/>
                    <isback
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/foundation/form/checkbox"
                            text="Is background image"
                            value="true"
                            name="./isback"/>
                    <!--<items jcr:primaryType="cq:WidgetCollection">
                        <imagePath
                                jcr:primaryType="cq:Widget"
                                xtype="pathfield"
                                fieldLabel="Select Image"
                                name="./imagePath"
                                rootPath="/content/dam/my-project"
                                anchor="{Boolean}true"
                                required="{Boolean}true"
                                allowUpload="{Boolean}false"
                                type="pathbrowser"
                                browseRoot="/content/dam/my-project"/>
                    </items>-->
                    <title
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldLabel="Title"
                        name="./title"
                        required="{Boolean}false"/>
                    <well-multifield
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/well"
                        fieldLabel="Naviagation">
                        <items jcr:primaryType="nt:unstructured">
                            <navigationitemswithmap
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                composite="{Boolean}true"
                                fieldDescription="Navigation Items"
                                fieldLabel="Navigation Items Multifield"
                                required="{Boolean}false">
                                <field
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/container"
                                    emptyText="Navigation Items Detail"
                                    name="./navigationitemswithmap">
                                    <items jcr:primaryType="nt:unstructured">
                                        <title
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                            emptyText="Mav Title Name Text"
                                            fieldLabel="Nav Title name Label"
                                            name="./titlenav"/>
                                        <path
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                fieldLabel="Navigation Items Image path"
                                                name="./pathnav"
                                                rootPath="/content/dam/my-project"/>
                                    </items>
                                </field>
                            </navigationitemswithmap>
                        </items>
                    </well-multifield>
                </items>
            </column>
        </items>
    </content>
</jcr:root>
